{
  "name": "XVS Parent",
  "short_name": "XVS Parent",
  "description": "Your children's classes, results, attendance and fees.",
  "id": "/parent/",
  "start_url": "/parent/",
  "scope": "/parent/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F9FAFB",
  "theme_color": "#4A659D",
  "icons": [
    { "src": "/parent/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/parent/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/parent/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "related_applications": [
    { "platform": "webapp", "url": "/parent/manifest.webmanifest" }
  ]
}
